<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app leaves the device: the session cookie, the pinned
     certificate fingerprint and the downloaded library are the person's.
     `allowBackup="false"` alone does NOT stop Android 12's device-to-device
     transfer; this rule does (the old app's file, unchanged in intent). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
