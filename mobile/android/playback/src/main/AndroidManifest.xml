<?xml version="1.0" encoding="utf-8"?>
<!-- :playback's own manifest, merged into the app's (docs/agents/mobile.md, MB0
     "Contract": ":playback declares NzMediaService (foregroundServiceType=
     mediaPlayback, intent filters androidx.media3.session.MediaLibraryService and
     android.media.browse.MediaBrowserService)").

     Both filters are what makes the notification, the lock screen, headset
     buttons, Bluetooth AVRCP and Android Auto reach the SAME service: Media3's
     MediaLibraryService answers the first, the platform's MediaBrowserService
     contract the second. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The permissions the SERVICE needs, declared where the service is: the
         merger de-duplicates `:app`'s identical entries, and a module whose
         foreground service type is `mediaPlayback` without the matching grant
         dies at `startForeground` with a SecurityException. `:app` declares them
         for the whole app; this module must stand on its own for its own
         instrumented tests (whose APK merges only THIS manifest). WAKE_LOCK covers
         the PARTIAL_WAKE_LOCK and the Wi-Fi lock the service holds. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="fr.neezer.mobile.playback.NzMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
