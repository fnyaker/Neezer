<?xml version="1.0" encoding="utf-8"?>
<!--
  :feature/nowplaying — the manifest of lot MB11.

  Its ONE entry is the `FileProvider` the lyric card shares through: a PNG written
  to the app's own cache is handed to the platform's share sheet as a `content://`
  URI, so no storage permission is asked for and nothing is ever written where
  another app could read it beyond the one file it was granted.

  The authority is namespaced to THIS module (`…nowplaying.cards`) so it cannot
  collide with `:app`'s own provider, and the paths file under `res/xml` exposes
  `cacheDir/cards` and nothing else.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.nowplaying.cards"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/nowplaying_shared_cards" />
        </provider>
    </application>
</manifest>
