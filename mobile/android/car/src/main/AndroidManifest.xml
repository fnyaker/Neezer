<?xml version="1.0" encoding="utf-8"?>
<!-- :car's manifest, merged into the app's (docs/agents/mobile.md, MB0 "Contract").
     EVERY component keeps its OLD fully-qualified name: a quick-settings tile the
     person added, a launcher shortcut and a pinned PendingIntent all point at
     `org.nsupysonic.app.*`, and an update that renamed them would leave a dead
     tile behind. MB24 fills the classes; this file is what makes the update
     survivable. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- The overlay itself: a foreground service, `specialUse` being the only
             Android 14 type that fits "draw a player over the navigation app". -->
        <service
            android:name="org.nsupysonic.app.CarModeService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|microphone"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Car mode overlay controlling this app's own playback while driving." />
        </service>

        <!-- Quick-settings tile. BIND_QUICK_SETTINGS_TILE is a system-held
             signature permission, so exported=true is safe. -->
        <service
            android:name="org.nsupysonic.app.CarTileService"
            android:exported="true"
            android:icon="@drawable/ic_car"
            android:label="@string/car_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The periodic look behind the car watch: no notification, and Android
             owns the schedule. -->
        <service
            android:name="org.nsupysonic.app.CarWatchJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The car mode's full-screen settings. Never exported: no other app may
             point the person at a screen that writes car preferences. -->
        <activity
            android:name="org.nsupysonic.app.CarSettingsActivity"
            android:exported="false"
            android:label="@string/car_mode"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <!-- Boot / update: re-arm the watch, never start the service. -->
        <receiver
            android:name="org.nsupysonic.app.CarBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- One rung of the watch's ladder (an explicit PendingIntent). -->
        <receiver
            android:name="org.nsupysonic.app.CarWakeReceiver"
            android:exported="false" />

        <!-- The car radio connecting or leaving: the Bluetooth broadcasts Android
             still delivers to a manifest receiver. -->
        <receiver
            android:name="org.nsupysonic.app.CarBluetoothReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
