<?xml version="1.0" encoding="utf-8"?>
<!-- :car's manifest, merged into the app's (docs/agents/mobile.md, MB0 "Contract").
     The components are named in THIS app's own package (`fr.neezer.mobile.car`):
     they were `org.nsupysonic.app.*` only for the abandoned install-over-the-old
     -app plan, and with a distinct `applicationId` a tile, a shortcut or a
     PendingIntent belongs to this package alone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The car mode's own permissions: the overlay window, the usage access that
         tells which app is in front (no AccessibilityService), the location for
         the speed lock, the microphone for the voice search, Bluetooth to hear
         the car radio, and the foreground types that keep all of that alive once
         the activity is behind the map. `:app` declares the same union (MB0's
         manifest), and a library that OWNS these components declares what it uses
         so lint can see it: the merge makes them one set, and a module that only
         borrowed `:app`'s copy failed lint's MissingPermission on its own code. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application>
        <!-- The overlay itself: a foreground service, `specialUse` being the only
             Android 14 type that fits "draw a player over the navigation app". -->
        <service
            android:name="fr.neezer.mobile.car.CarModeService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|microphone"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Car mode overlay controlling this app's own playback while driving." />
        </service>

        <!-- Quick-settings tile. BIND_QUICK_SETTINGS_TILE is a system-held
             signature permission, so exported=true is safe. -->
        <service
            android:name="fr.neezer.mobile.car.CarTileService"
            android:exported="true"
            android:icon="@drawable/ic_car"
            android:label="@string/car_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The periodic look behind the car watch: no notification, and Android
             owns the schedule. -->
        <service
            android:name="fr.neezer.mobile.car.CarWatchJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The car mode's full-screen settings. Never exported: no other app may
             point the person at a screen that writes car preferences. -->
        <activity
            android:name="fr.neezer.mobile.car.CarSettingsActivity"
            android:exported="false"
            android:label="@string/car_mode"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <!-- Boot / update: re-arm the watch, never start the service. -->
        <receiver
            android:name="fr.neezer.mobile.car.CarBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- One rung of the watch's ladder (an explicit PendingIntent). -->
        <receiver
            android:name="fr.neezer.mobile.car.CarWakeReceiver"
            android:exported="false" />

        <!-- The car radio connecting or leaving: the Bluetooth broadcasts Android
             still delivers to a manifest receiver. -->
        <receiver
            android:name="fr.neezer.mobile.car.CarBluetoothReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
